/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/spec",
    "types": [
      "vitest/globals"
    ]
  },
  "include": [
    "src/**/*.d.ts",
    "src/**/*.spec.ts",
    // `test-setup.ts` va explícito: el `ng new` no lo incluye y el builder lo bundlea igual,
    // pero fuera del programa de TS queda SIN chequeo de tipos (el builder lo avisa con un
    // WARNING que es fácil pasar por alto). Es el archivo que shimea `matchMedia` para toda
    // la suite, así que un error de tipos ahí rompería todos los specs a la vez.
    "src/test-setup.ts"
  ]
}
