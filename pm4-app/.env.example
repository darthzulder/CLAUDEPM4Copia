# ── ProcessMaker 4 ────────────────────────────────────────────────────────────
# PM4_BASE_URL identifica la instancia PM4 activa — cambia entre entornos/migraciones,
# nunca hardcodear un hostname en código o documentación (ver pm4-app/CLAUDE.md
# § "Registro de IDs PM4"). Tras cambiar este valor, correr:
#   node scripts/pm4-registry-sync.mjs --check   # ver qué cambió
#   node scripts/pm4-registry-sync.mjs --update  # aplicar (resuelve por nombre/uuid)
PM4_BASE_URL=https://<instancia-pm4-actual>.processmaker.net
PM4_TOKEN=eyJ...          # Bearer token para dev (fallback del backend)
PORT=3001

VITE_TASK_ID=123          # task_id fallback para frontend dev (?task_id= en la URL lo pisa)
VITE_PM4_TOKEN=eyJ...     # token fallback para frontend dev (?token= en la URL lo pisa)
VITE_CASE_ID=             # case_id fallback para frontend dev (pantallas que resuelven por caso, no por tarea)

# NOTA: los IDs de colección/script/proceso de PM4 (antes leídos de env vars como
# WEB_ENTRY_PROCESS_ID/WEB_ENTRY_EVENT_ID/VITE_SIMILAR_CASES_SCRIPT_ID) ya NO se
# configuran acá — viven en frontend/src/config/pm4-registry.json, mantenido por
# scripts/pm4-registry-sync.mjs. No agregar overrides de IDs PM4 vía env var de nuevo:
# el registro es el único mecanismo.

# ── Encriptación del token de iframe (PM4 → backend) ─────────────────────────
IFRAME_ENCRYPTION_KEY=CambiarEstaClave

# ── Micro-servicio de cálculo (cotizador) ────────────────────────────────────
COTIZADOR_API_URL=http://cotizador-service:5001

# ── Configuración de país (Feature Flags / Valores por defecto) ──────────────
VITE_DEFAULT_COUNTRY_CODE=170
VITE_LOCK_COUNTRY=true

# ── Google reCAPTCHA v2 (Checkbox "No soy un robot", SCR-000) ────────────────
# Site key: público, lo consume el frontend (requiere prefijo VITE_).
VITE_RECAPTCHA_SITE_KEY=6Le...
# Secret key: SOLO backend, para verificar el token contra Google (api/siteverify).
RECAPTCHA_SECRET_KEY=6Le...
