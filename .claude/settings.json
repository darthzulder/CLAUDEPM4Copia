{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -NonInteractive -File \".claude/read-graph.ps1\"",
            "shell": "powershell",
            "timeout": 10,
            "statusMessage": "Consultando grafo del proyecto..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__pm4-scripts__pm4_(update|run)_script",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/pm4-capture.mjs\"",
            "timeout": 60,
            "statusMessage": "Guardando el estado previo del script..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__pm4-scripts__pm4_(update|run)_script",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/pm4-capture.mjs\"",
            "timeout": 60,
            "statusMessage": "Registrando el script en el historial..."
          }
        ]
      }
    ]
  }
}
